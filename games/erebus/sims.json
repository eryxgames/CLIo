{
 "reactor": {
  "title": "REACTOR  wake the core",
  "mode": "systems",
  "time": 90,
  "controls": {
   "rods": {
    "label": "Rods out",
    "keys": [
     "up",
     "down"
    ],
    "min": 0,
    "max": 100,
    "start": 10,
    "step": 25
   },
   "flow": {
    "label": "Flow",
    "keys": [
     "right",
     "left"
    ],
    "min": 0,
    "max": 100,
    "start": 30,
    "step": 30
   }
  },
  "functions": {
   "scram": {
    "label": "Scram",
    "key": "x",
    "hold": 1,
    "lasts": 8,
    "cooldown": 6,
    "keeps": {
     "rods": 0
    },
    "tone": "hot",
    "words": {
     "on": "RODS IN"
    },
    "says": "SCRAM. The rods are in, and stay in for eight seconds."
   },
   "vent": {
    "label": "Vent steam",
    "key": "v",
    "if": "heat > 700",
    "why": "the core is not hot enough to vent",
    "add": {
     "heat": -220
    },
    "cooldown": 15,
    "tone": "warn",
    "says": "Steam vented to space."
   }
  },
  "systems": {
   "heat": {
    "rate": "rods * 6 - flow * 3.2 - (heat - 300) * 0.05",
    "start": 300,
    "min": 280,
    "max": 1400
   },
   "power": {
    "value": "clamp((heat - 400) / 5, 0, 120) * (0.4 + flow / 170)"
   },
   "steady": {
    "rate": "1 if power >= 80 and heat < 1000 else -2",
    "start": 0,
    "min": 0,
    "max": 10
   },
   "power_heat": {
    "value": "power * 9"
   },
   "spread": {
    "value": "max(0, heat - 500) * 0.35"
   }
  },
  "chart": [
   "heat",
   "power"
  ],
  "win_if": "steady >= 10",
  "fail_if": "heat >= 1300",
  "fail_text": "The core is past its limit.",
  "score": "steady * 20 + min(power, 100) - max(0, heat - 1000) / 5",
  "panels": {
   "colour": "green",
   "rows": [
    {
     "size": 4,
     "widgets": [
      {
       "text": "Pull the rods out and the core heats; coolant flow carries the heat off and turns the turbines. Hold 80% for ten seconds. Too hot: vent steam (V), or hold X to scram.",
       "align": "center"
      }
     ]
    },
    {
     "cols": [
      {
       "title": "CORE",
       "size": 40,
       "pulse": "bar",
       "widgets": [
        {
         "gauge": "heat",
         "max": 1400,
         "warn": 0.7,
         "hot": 0.85,
         "unit": "K"
        },
        {
         "control": "rods",
         "max": 100,
         "keys": [
          "up",
          "down"
         ],
         "label": "rods out"
        },
        {
         "control": "flow",
         "max": 100,
         "keys": [
          "right",
          "left"
         ]
        },
        {
         "number": "power",
         "big": true,
         "unit": "%"
        },
        {
         "gauge": "steady",
         "label": "holding",
         "max": 10,
         "unit": "s"
        },
        {
         "lamps": [
          {
           "label": "CRITICAL",
           "if": "heat > 400"
          },
          {
           "label": "AT POWER",
           "if": "power >= 80",
           "tone": "good"
          },
          {
           "label": "OVERHEAT",
           "if": "heat >= 1000",
           "tone": "hot"
          },
          {
           "label": "SCRAM",
           "if": "scram",
           "tone": "hot"
          }
         ]
        },
        {
         "rule": true
        },
        {
         "functions": true
        }
       ]
      },
      {
       "title": "SHIP  heat",
       "widgets": [
        {
         "plot": [
          "heat",
          "power"
         ],
         "rows": 6
        },
        {
         "scope": {
          "model": "hauler",
          "view": "heat",
          "max": 1400,
          "turn": 10,
          "values": {
           "reactor": "heat",
           "engines": "power_heat",
           "decks": "spread",
           "hold": "spread",
           "bridge": "spread",
           "body": "spread"
          },
          "pitch": -18
         }
        }
       ]
      }
     ]
    }
   ]
  },
  "intro": [
   "The core is banked low. Pull the rods, keep the flow, hold 80% for ten seconds.",
   "Too hot: V vents steam; hold X to scram."
  ]
 },
 "scan": {
  "title": "SCAN  a place to come down",
  "mode": "systems",
  "intro": [
   "Hold the beam on the old relay mast until the picture is whole.",
   "Then leave a beacon beside it: hold B, and watch it unfold."
  ],
  "time": 90,
  "controls": {
   "beam": {
    "label": "Beam",
    "keys": [
     "right",
     "left"
    ],
    "min": 0,
    "max": 100,
    "start": 50,
    "step": 35
   }
  },
  "functions": {
   "narrow": {
    "label": "Narrow beam",
    "key": "n",
    "toggle": true,
    "tone": "warn",
    "says": "Beam narrowed: it reads faster, and forgives less.",
    "says_off": "Beam wide."
   },
   "beacon": {
    "label": "Deploy beacon",
    "key": "b",
    "hold": 2,
    "if": "scan >= 100",
    "why": "the picture is not whole yet",
    "uses": 1,
    "lasts": 4,
    "tone": "good",
    "words": {
     "on": "DESCENT",
     "spent": "DOWN"
    },
    "says": "Beacon away.",
    "effects": [
     {
      "set": "beacon_down"
     }
    ]
   }
  },
  "systems": {
   "target": {
    "value": "50 + 30 * (abs((time * 5) % 40 - 20) - 10) / 10"
   },
   "off": {
    "value": "abs(beam - target)"
   },
   "lock": {
    "value": "clamp(100 - off * (4 + 4 * narrow), 0, 100)"
   },
   "scan": {
    "rate": "lock / 100 * (4.0 + 3.0 * narrow) if lock > 40 else 0",
    "start": 0,
    "min": 0,
    "max": 100
   },
   "deck": {
    "value": "floor(time / 6) % 2"
   },
   "below": {
    "value": "time * 2"
   },
   "unfold": {
    "value": "max(beacon_charge, min(1, beacon_done))"
   }
  },
  "win_if": "beacon_done >= 1 and not beacon",
  "score": "scan + lock / 10 + 40 * beacon_charge + 100 * beacon_done",
  "panels": {
   "colour": "cyan",
   "cols": [
    {
     "size": 36,
     "rows": [
      {
       "title": "BEAM",
       "size": 7,
       "widgets": [
        {
         "gauge": "target",
         "max": 100,
         "label": "mast"
        },
        {
         "control": "beam",
         "max": 100,
         "keys": [
          "right",
          "left"
         ]
        },
        {
         "gauge": "lock",
         "max": 100,
         "warn": -0.4
        },
        {
         "space": 1
        },
        {
         "lamps": [
          {
           "label": "LOCK",
           "if": "lock > 40",
           "tone": "good"
          },
          {
           "label": "DRIFT",
           "if": "lock <= 40",
           "tone": "warn"
          }
         ]
        }
       ]
      },
      {
       "title": "SURVEY",
       "size": 9,
       "widgets": [
        {
         "number": "scan",
         "big": true,
         "unit": "%"
        },
        {
         "gauge": "scan",
         "max": 100,
         "label": "known"
        },
        {
         "rule": true
        },
        {
         "functions": true
        }
       ]
      },
      {
       "title": "LOCK",
       "widgets": [
        {
         "plot": [
          "lock"
         ],
         "min": 0,
         "max": 100,
         "rows": 5
        }
       ]
      }
     ]
    },
    {
     "rows": [
      {
       "title": "OBJECT 7  RELAY MAST",
       "pulse": "bar",
       "widgets": [
        {
         "scope": {
          "model": "mast",
          "reveal": "scan",
          "whole": 100,
          "turn": 14
         }
        }
       ]
      },
      {
       "size": 13,
       "cols": [
        {
         "title": "BELOW  surface",
         "widgets": [
          {
           "planet": "moon",
           "view": "surface",
           "sites": [
            {
             "name": "BEACON",
             "lat": -6,
             "lon": -113,
             "if": "beacon_done >= 1 and not beacon"
            }
           ],
           "turn": "below"
          }
         ]
        },
        {
         "title": "BELOW  relief",
         "widgets": [
          {
           "scan": {
            "planet": "moon",
            "unit": "KM",
            "turn": "below"
           }
          }
         ]
        },
        {
         "title": "BEACON",
         "colour": "amber",
         "widgets": [
          {
           "scope": {
            "model": "beacon",
            "view": "solid",
            "clip": "deploy",
            "at": "unfold",
            "turn": 20,
            "pitch": 14
           }
          }
         ]
        }
       ]
      }
     ]
    }
   ]
  },
  "fail_if": "time >= 86 and beacon_done < 1",
  "fail_text": "Too late for a beacon: the pass is over."
 },
 "bay": {
  "title": "BAY 2  the lander out",
  "mode": "systems",
  "time": 90,
  "intro": [
   "Bleed the bay's air (V), then run the doors open (Up).",
   "Clamps off: hold C. Then swing the lander out: hold S."
  ],
  "controls": {
   "motor": {
    "label": "Door motor",
    "keys": [
     "up",
     "down"
    ],
    "min": 0,
    "max": 100,
    "start": 0,
    "step": 45
   }
  },
  "functions": {
   "bleed": {
    "label": "Bleed valve",
    "key": "v",
    "toggle": true,
    "tone": "warn",
    "says": "The bay's air goes out to space.",
    "says_off": "Valve shut."
   },
   "clamps": {
    "label": "Release clamps",
    "key": "c",
    "hold": 1,
    "if": "pressure < 5",
    "why": "the bay still holds air",
    "uses": 1,
    "tone": "good",
    "words": {
     "spent": "OFF"
    },
    "says": "Clamps off. The lander hangs on its arm."
   },
   "swing": {
    "label": "Swing out",
    "key": "s",
    "hold": 2,
    "if": "doors >= 100 and clamps_done >= 1",
    "why": "the doors are not open, or the clamps hold",
    "uses": 1,
    "lasts": 3,
    "tone": "good",
    "words": {
     "on": "SWINGING",
     "spent": "AWAY"
    },
    "says": "The arm swings the lander out past the doors."
   }
  },
  "systems": {
   "pressure": {
    "rate": "-40 * bleed",
    "start": 100,
    "min": 0,
    "max": 100
   },
   "doors": {
    "rate": "motor * 0.42 if pressure < 5 else 0",
    "start": 0,
    "min": 0,
    "max": 100
   },
   "strain": {
    "rate": "motor * 0.6 if pressure >= 5 else -25",
    "start": 0,
    "min": 0,
    "max": 100
   },
   "away": {
    "rate": "34 * swing",
    "start": 0,
    "min": 0,
    "max": 100
   },
   "stage": {
    "value": "0.6 * doors / 100 + 0.4 * away / 100"
   }
  },
  "win_if": "away >= 100",
  "fail_if": "strain >= 100",
  "fail_text": "The door motors burn out against the air",
  "score": "(100 - pressure) + doors + 120 * clamps_done + 40 * clamps_charge + 60 * swing_charge + 3 * away - 2 * strain",
  "panels": {
   "colour": "cyan",
   "cols": [
    {
     "size": 38,
     "rows": [
      {
       "title": "BAY 2",
       "size": 12,
       "widgets": [
        {
         "gauge": "pressure",
         "max": 100,
         "label": "air",
         "unit": "%",
         "warn": 0.05
        },
        {
         "control": "motor",
         "max": 100,
         "keys": [
          "up",
          "down"
         ]
        },
        {
         "gauge": "doors",
         "max": 100,
         "unit": "%"
        },
        {
         "gauge": "strain",
         "max": 100,
         "warn": 0.4,
         "hot": 0.7
        },
        {
         "space": 1
        },
        {
         "lamps": [
          {
           "label": "AIR",
           "if": "pressure >= 5",
           "tone": "warn"
          },
          {
           "label": "OPEN",
           "if": "doors >= 100",
           "tone": "good"
          },
          {
           "label": "CLAMPS",
           "if": "clamps_done < 1",
           "tone": "warn"
          },
          {
           "label": "AWAY",
           "if": "away >= 100",
           "tone": "good"
          }
         ]
        },
        {
         "rule": true
        },
        {
         "functions": true
        }
       ]
      },
      {
       "title": "AIR AND DOORS",
       "widgets": [
        {
         "plot": [
          "pressure",
          "doors"
         ],
         "min": 0,
         "max": 100
        }
       ]
      }
     ]
    },
    {
     "rows": [
      {
       "title": "BAY 2  from outside",
       "pulse": "bar",
       "widgets": [
        {
         "scope": {
          "model": "bay",
          "view": "solid",
          "clip": "open",
          "at": "stage",
          "yaw": 205,
          "turn": 0,
          "pitch": 24
         }
        }
       ]
      },
      {
       "size": 11,
       "cols": [
        {
         "title": "LANDER",
         "colour": "amber",
         "widgets": [
          {
           "scope": {
            "model": "bay",
            "view": "structure",
            "clip": "open",
            "at": "stage",
            "yaw": 150,
            "turn": 6
           }
          }
         ]
        },
        {
         "title": "BELOW",
         "widgets": [
          {
           "planet": "moon",
           "view": "surface",
           "sites": [
            {
             "name": "BEACON",
             "lat": -6,
             "lon": -113
            }
           ]
          }
         ]
        }
       ]
      }
     ]
    }
   ]
  }
 },
