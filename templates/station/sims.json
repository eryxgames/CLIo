{
 "helm": {
  "title": "HELM  hopper to the pad",
  "map": [
   "##################################",
   "#@.....,,,,,.......TT......##....#",
   "#......,,,,........TT.....###....#",
   "#..::..====.....................##",
   "#..::..=..=...BB.........~~~.....#",
   "#......=..=...BB.........~~~~....#",
   "#......=..==========.....~~~.....#",
   "#...1..............=.........2...#",
   "#..................=.....,,HH....#",
   "#....##............=======.HH....#",
   "#...###..........TT..............#",
   "##################################"
  ],
  "vehicle": {
   "model": "hover",
   "fuel": 60
  },
  "land": true,
  "time": 150,
  "systems": {
   "heat": {
    "rate": "thrust * 9 - (heat - 20) * 0.25",
    "start": 20,
    "min": 20,
    "damage_over": 95
   }
  },
  "functions": {
   "flush": {
    "label": "Flush coolant",
    "key": "f",
    "if": "heat > 40",
    "why": "the coils are cool",
    "add": {
     "heat": -30
    },
    "cooldown": 10,
    "says": "Coolant flushed."
   }
  },
  "panels": {
   "colour": "amber",
   "rows": [
    {
     "cols": [
      {
       "rows": [
        {
         "title": "AHEAD",
         "widgets": [
          {
           "ahead": true
          }
         ]
        },
        {
         "title": "SURFACE",
         "size": 9,
         "widgets": [
          {
           "map": true
          }
         ]
        }
       ]
      },
      {
       "size": 34,
       "rows": [
        {
         "title": "FLIGHT",
         "size": 10,
         "widgets": [
          {
           "compass": "heading"
          },
          {
           "gauge": "speed",
           "max": "max_speed",
           "unit": ""
          },
          {
           "gauge": "height",
           "label": "height",
           "max": 6
          },
          {
           "center": "climb",
           "max": 3
          },
          {
           "gauge": "fuel",
           "max": "fuel_max",
