           "functions": true
          }
         ]
        },
        {
         "title": "NEXT",
         "size": 5,
         "widgets": [
          {
           "number": "next",
           "label": "to the mark",
           "big": true
          }
         ]
        },
        {
         "title": "RELIEF",
         "colour": "green",
         "widgets": [
          {
           "scan": true
          }
         ]
        }
       ]
      }
     ]
    }
   ]
