 },
 "reactor": {
  "title": "REACTOR  bring the core to power",
  "mode": "systems",
  "time": 90,
  "controls": {
   "rods": {
    "label": "Rods out",
    "keys": [
     "up",
     "down"
    ],
    "min": 0,
    "max": 100,
    "start": 10,
    "step": 25
   },
   "flow": {
    "label": "Flow",
    "keys": [
     "right",
     "left"
    ],
    "min": 0,
    "max": 100,
    "start": 30,
    "step": 30
   }
  },
  "functions": {
   "scram": {
    "label": "Scram",
    "key": "x",
    "hold": 1,
    "lasts": 8,
    "cooldown": 6,
    "keeps": {
     "rods": 0
    },
    "tone": "hot",
    "words": {
     "on": "RODS IN"
    },
    "says": "SCRAM. The rods are in, and stay in for eight seconds."
   },
   "vent": {
    "label": "Vent steam",
    "key": "v",
    "if": "heat > 700",
    "why": "the core is not hot enough to vent",
    "add": {
     "heat": -220
    },
    "cooldown": 15,
    "tone": "warn",
    "says": "Steam vented to space."
   }
  },
  "systems": {
   "heat": {
    "rate": "rods * 6 - flow * 3.2 - (heat - 300) * 0.05",
    "start": 300,
    "min": 280,
    "max": 1400
   },
   "power": {
    "value": "clamp((heat - 400) / 5, 0, 120) * (0.4 + flow / 170)"
   },
   "steady": {
    "rate": "1 if power >= 80 and heat < 1000 else -2",
    "start": 0,
    "min": 0,
    "max": 10
   },
   "power_heat": {
    "value": "power * 9"
   },
   "spread": {
    "value": "max(0, heat - 500) * 0.35"
   }
  },
  "chart": [
   "heat",
   "power"
  ],
  "win_if": "steady >= 10",
  "fail_if": "heat >= 1300",
  "fail_text": "The core is past its limit.",
  "score": "steady * 20 + min(power, 100) - max(0, heat - 1000) / 5",
  "panels": {
   "colour": "green",
   "rows": [
    {
     "size": 4,
     "widgets": [
      {
       "text": "Pull the rods out and the core heats; coolant flow carries the heat off and turns the turbines. Hold 80% for ten seconds. Too hot: vent steam (V), or hold X to scram.",
       "align": "center"
      }
     ]
    },
    {
     "cols": [
      {
       "title": "CORE",
       "size": 40,
       "pulse": "bar",
       "widgets": [
        {
         "gauge": "heat",
         "max": 1400,
         "warn": 0.7,
         "hot": 0.85,
         "unit": "K"
        },
        {
         "control": "rods",
         "max": 100,
         "keys": [
          "up",
          "down"
         ],
         "label": "rods out"
        },
        {
         "control": "flow",
         "max": 100,
         "keys": [
          "right",
          "left"
         ]
        },
        {
         "number": "power",
         "big": true,
         "unit": "%"
        },
        {
         "gauge": "steady",
         "label": "holding",
         "max": 10,
         "unit": "s"
        },
        {
         "lamps": [
          {
           "label": "CRITICAL",
           "if": "heat > 400"
          },
          {
           "label": "AT POWER",
           "if": "power >= 80",
           "tone": "good"
          },
          {
           "label": "OVERHEAT",
           "if": "heat >= 1000",
           "tone": "hot"
          },
          {
           "label": "SCRAM",
           "if": "scram",
           "tone": "hot"
          }
         ]
        },
        {
         "rule": true
        },
        {
         "functions": true
        }
       ]
      },
      {
       "title": "SHIP  heat",
       "widgets": [
        {
         "plot": [
          "heat",
          "power"
         ],
         "rows": 6
        },
        {
         "scope": {
          "model": "hauler",
          "view": "heat",
          "max": 1400,
          "turn": 10,
          "values": {
           "reactor": "heat",
           "engines": "power_heat",
           "decks": "spread",
           "hold": "spread",
           "bridge": "spread",
           "body": "spread"
          },
          "pitch": -18
         }
        }
       ]
      }
     ]
    }
   ]
  }
 },
 "scan": {
  "title": "SCAN  the mast, and a beacon beside it",
  "mode": "systems",
  "intro": [
   "Hold the beam on the mast until the picture is whole.",
   "Then leave a beacon beside it: hold B."
  ],
  "time": 90,
  "controls": {
   "beam": {
    "label": "Beam",
    "keys": [
     "right",
     "left"
    ],
    "min": 0,
    "max": 100,
    "start": 50,
    "step": 35
   }
  },
  "functions": {
   "narrow": {
    "label": "Narrow beam",
    "key": "n",
    "toggle": true,
    "tone": "warn",
    "says": "Beam narrowed: it reads faster, and forgives less.",
    "says_off": "Beam wide."
   },
   "beacon": {
    "label": "Deploy beacon",
    "key": "b",
    "hold": 2,
    "if": "scan >= 100",
    "why": "the picture is not whole yet",
    "uses": 1,
    "lasts": 4,
    "tone": "good",
    "words": {
     "on": "DESCENT",
     "spent": "DOWN"
    },
    "says": "Beacon away.",
    "effects": [
     {
      "set": "beacon_down"
     }
    ]
   }
  },
  "systems": {
   "target": {
    "value": "50 + 30 * (abs((time * 5) % 40 - 20) - 10) / 10"
   },
   "off": {
    "value": "abs(beam - target)"
   },
   "lock": {
    "value": "clamp(100 - off * (4 + 4 * narrow), 0, 100)"
   },
   "scan": {
    "rate": "lock / 100 * (4.0 + 3.0 * narrow) if lock > 40 else 0",
    "start": 0,
    "min": 0,
    "max": 100
   },
   "deck": {
    "value": "floor(time / 6) % 2"
   },
   "below": {
    "value": "time * 2"
   }
  },
  "win_if": "beacon_done >= 1 and not beacon",
  "score": "scan + lock / 10 + 40 * beacon_charge + 100 * beacon_done",
  "panels": {
   "colour": "cyan",
   "cols": [
    {
     "size": 36,
     "rows": [
      {
       "title": "BEAM",
       "size": 7,
       "widgets": [
        {
         "gauge": "target",
         "max": 100,
         "label": "mast"
        },
        {
         "control": "beam",
         "max": 100,
         "keys": [
          "right",
          "left"
         ]
        },
        {
         "gauge": "lock",
         "max": 100,
         "warn": -0.4
        },
        {
         "space": 1
        },
        {
         "lamps": [
          {
           "label": "LOCK",
           "if": "lock > 40",
           "tone": "good"
          },
          {
           "label": "DRIFT",
           "if": "lock <= 40",
           "tone": "warn"
          }
         ]
        }
       ]
      },
      {
       "title": "SURVEY",
       "size": 9,
       "widgets": [
        {
         "number": "scan",
         "big": true,
         "unit": "%"
        },
        {
         "gauge": "scan",
         "max": 100,
         "label": "known"
        },
        {
         "rule": true
        },
        {
         "functions": true
        }
       ]
      },
      {
       "title": "LOCK",
       "widgets": [
        {
         "plot": [
          "lock"
         ],
         "min": 0,
         "max": 100,
         "rows": 5
        }
       ]
      }
     ]
    },
    {
     "rows": [
      {
       "title": "OBJECT 7  RELAY MAST",
       "pulse": "bar",
       "widgets": [
        {
         "scope": {
          "model": "mast",
          "reveal": "scan",
          "whole": 100,
          "turn": 14
         }
        }
       ]
      },
      {
       "size": 13,
       "cols": [
        {
         "title": "BELOW  surface",
         "widgets": [
          {
           "planet": "moon",
           "view": "surface",
           "sites": [
            {
             "name": "BEACON",
             "lat": -6,
             "lon": -113,
             "if": "beacon_done >= 1 and not beacon"
            }
           ],
           "turn": "below"
          }
         ]
        },
        {
         "title": "BELOW  relief",
         "widgets": [
          {
           "scan": {
            "planet": "moon",
            "unit": "KM",
            "turn": "below"
           }
          }
         ]
        },
        {
         "title": "HAULER  decks",
         "colour": "green",
         "widgets": [
          {
           "scope": {
            "model": "hauler",
            "view": "plan",
            "levels": 2,
            "level": "deck"
           }
          }
         ]
        }
       ]
      }
     ]
    }
   ]
  },
  "fail_if": "time >= 86 and beacon_done < 1",
  "fail_text": "Too late for a beacon: the pass is over."
 }
}
